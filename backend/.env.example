# Shiprocket API user credentials (Settings > API > Add New API User)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Used only when an order has no valid customer email.
SHIPROCKET_BILLING_EMAIL=

# A separate random secret shared with the Shiprocket webhook configuration.
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_TIMEOUT_MS=20000
SHIPROCKET_PICKUP_SYNC_INTERVAL_MS=300000
SHIPROCKET_PICKUP_SYNC_BATCH_SIZE=25
SHIPROCKET_TRACKING_SYNC_INTERVAL_MS=900000
SHIPROCKET_TRACKING_SYNC_BATCH_SIZE=50

# Configure this callback in Shiprocket Settings > API > Webhooks:
# https://your-api-domain.example/api/v1/logistics/events
