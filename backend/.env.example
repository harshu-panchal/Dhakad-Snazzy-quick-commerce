# Shiprocket API user credentials (Settings > API > Add New API User)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Used only when an order has no valid customer email.
SHIPROCKET_BILLING_EMAIL=

# A separate random secret shared with the Shiprocket webhook configuration.
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_TIMEOUT_MS=20000
SHIPROCKET_PICKUP_SYNC_INTERVAL_MS=300000
SHIPROCKET_PICKUP_SYNC_BATCH_SIZE=25
SHIPROCKET_TRACKING_SYNC_INTERVAL_MS=900000
SHIPROCKET_TRACKING_SYNC_BATCH_SIZE=50

# Configure this callback in Shiprocket Settings > API > Webhooks:
# https://your-api-domain.example/api/v1/logistics/events
# Razorpay API credentials and the separate secret configured for this exact
# webhook URL in the Razorpay dashboard:
# https://your-api-domain.example/api/v1/payment/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_WORKER_ENABLED=true
RAZORPAY_PAYMENT_WORKER_INTERVAL_MS=300000

# Keep USE_MOCK_OTP=false in production so real OTP messages are delivered.
# If an emergency fixed admin OTP is required, this allows 9999 only for Admin
# verification while preserving real OTP delivery for every user type.
USE_MOCK_OTP=false
ALLOW_ADMIN_FIXED_OTP_IN_PRODUCTION=false

# ---------------------------------------------------------------------------
# Admin RBAC, sessions and password reset
# ---------------------------------------------------------------------------

# SMTP for admin password-reset emails. Provider-agnostic: any mailbox works.
# Without these, forgot-password still returns its usual response but no mail
# is sent (a warning is logged at startup and on each attempt).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dhakad Snazzy <no-reply@dhakadsnazzy.com>"

# Base URL used to build the reset link in those emails.
ADMIN_PANEL_URL=https://www.dhakadsnazzy.com

# Admin session lifetimes. The access token is short-lived; the refresh token
# lives in an httpOnly cookie and rotates on every use.
ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=30
ADMIN_RESET_TOKEN_TTL_MINUTES=30

# How long a role's permissions are cached in process. A role edit invalidates
# the cache immediately in the same process; this TTL is the backstop for
# changes made by another process (a script, or a second server instance).
ROLE_CACHE_TTL_MS=30000

# Audit log retention. Unset or 0 keeps records forever (the safe default for
# an audit trail). Set a positive number of days to have MongoDB expire them.
# Only affects records written after it is set.
AUDIT_LOG_RETENTION_DAYS=
AUDIT_LOG_MAX_BODY_BYTES=8192

# Rate limits. Enabled in every environment; raise these locally rather than
# disabling them.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_RESET_MAX=10

# Required when the API sits behind a reverse proxy, or every rate limiter
# keys to the proxy's IP and becomes global instead of per-client.
# Automatically enabled when NODE_ENV=production.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Default admin, created on first boot only. Must satisfy the password policy
# (8+ chars, one uppercase, one lowercase, one digit). This account is seeded
# as Super Admin, which signs in with mobile OTP rather than this password.
DEFAULT_ADMIN_MOBILE=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_ROLE=Super Admin
